# Copy to .env and fill in. Never commit .env.
# Bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID (public, safe to share)
APPLICATION_ID=1559417160596725830
# Optional: a guild ID to sync slash commands to instantly while developing.
# Leave empty to sync globally (can take up to an hour to appear).
DEV_GUILD_ID=
# SQLite database file
DATABASE_PATH=nyan.db
